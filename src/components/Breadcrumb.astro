---
interface Props {
  items: { label: string; href?: string }[];
  light?: boolean;
}

const { items, light = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="パンくずリスト" class={`text-sm mb-4 ${light ? 'text-white/60' : 'text-gray-500'}`}>
  <ol class="flex flex-wrap items-center gap-1">
    <li>
      <a href={base} class={`transition-colors ${light ? 'hover:text-white' : 'hover:text-primary-800'}`}>トップ</a>
    </li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        <span class={light ? 'text-white/40' : 'text-gray-400'}>/</span>
        {item.href && i < items.length - 1 ? (
          <a href={base + item.href.replace(/^\//, '')} class={`transition-colors ${light ? 'hover:text-white' : 'hover:text-primary-800'}`}>
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class={`font-semibold ${light ? 'text-white' : 'text-primary-900'}`}>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
