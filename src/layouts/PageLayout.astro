---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumb?: { label: string; href?: string }[];
  wide?: boolean;
}

const { title, description, breadcrumb, wide = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="flex-1">
    <!-- Page header band -->
    <div class="relative overflow-hidden" style="background: linear-gradient(135deg, #1e40af 0%, #2563eb 55%, #bfdbfe 100%);">
      <div class={`mx-auto px-6 pt-10 pb-8 ${wide ? 'max-w-6xl' : 'max-w-3xl'}`}>
        {breadcrumb && <Breadcrumb items={breadcrumb} light />}
        <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">{title}</h1>
      </div>
    </div>
    <div class={`mx-auto px-6 py-12 md:py-16 ${wide ? 'max-w-6xl' : 'max-w-3xl'}`}>
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>
