---
import PageLayout from '../layouts/PageLayout.astro';
import divisions from '../data/divisions.json';

const base = import.meta.env.BASE_URL;
---

<PageLayout title="部門紹介" breadcrumb={[{ label: '部門紹介' }]} wide>
  <p class="text-[15px] text-primary-600 leading-[1.9] mb-4 max-w-2xl">
    検査部は5つの部門で構成され、病院で行われる幅広い検査を担当しています。
  </p>

  <!-- 部門インデックス -->
  <div class="flex flex-wrap gap-2 mb-16">
    {divisions.map((d) => (
      <a
        href={`#${d.id}`}
        class="inline-flex items-center rounded-full border border-primary-200 bg-white px-4 py-1.5 text-sm text-primary-700 hover:bg-primary-50 transition-colors"
      >
        {d.name}
      </a>
    ))}
  </div>

  <!-- 各部門 -->
  <div class="space-y-24 md:space-y-32">
    {divisions.map((d, i) => (
      <section id={d.id} class="scroll-mt-24 fade-up">
        <div class={`grid md:grid-cols-2 gap-8 md:gap-14 items-center ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
          <!-- ビジュアル -->
          <div class="rounded-3xl overflow-hidden border border-primary-100 shadow-sm"
               style="background: linear-gradient(135deg, #eff6ff 0%, #fff7ed 100%);">
            <img
              src={`${base}images/divisions/${d.image}`}
              alt={d.name}
              class="w-full aspect-square object-cover"
              loading="lazy"
            />
          </div>

          <!-- テキスト -->
          <div>
            <span class="inline-block h-1 w-10 rounded-full bg-accent-500 mb-4"></span>
            <h2 class="text-2xl md:text-3xl font-bold text-primary-900 mb-4 leading-tight">{d.name}</h2>
            <p class="text-[15px] font-medium text-primary-700 mb-3 leading-[1.9]">{d.summary}</p>
            <p class="text-sm text-primary-600 leading-[1.9] mb-6">{d.description}</p>
            <div class="flex flex-wrap gap-2">
              {d.items.map((item) => (
                <span class="text-[13px] rounded-full border border-primary-200 bg-white px-3.5 py-1.5 text-primary-700">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <script>
    // スクロールで各部門をふわっと表示
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.fade-up').forEach((el) => io.observe(el));
  </script>
</PageLayout>
