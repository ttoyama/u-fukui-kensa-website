---
import PageLayout from '../layouts/PageLayout.astro';
import research from '../data/research.json';

const base = import.meta.env.BASE_URL;
---

<PageLayout title="研究紹介" breadcrumb={[{ label: '研究紹介' }]} wide>
  <p class="text-[15px] text-primary-600 leading-[1.9] mb-4 max-w-2xl">
    検査部では、日々の検査業務のなかで生まれた疑問を研究テーマにして、
    臨床検査技師と医師が一緒に研究に取り組んでいます。
    ここでは、学会で発表した研究テーマを紹介しています。
  </p>
  <p class="text-xs text-primary-400 mb-12">
    発表した論文・演題の一覧は<a href={base + 'achievements/'} class="text-accent-600 underline underline-offset-2">研究業績</a>をご覧ください。
  </p>

  <div class="grid md:grid-cols-2 gap-6">
    {research.map((r) => (
      <div class="rounded-2xl border border-primary-100 overflow-hidden bg-white shadow-sm">
        {r.image && (
          <img
            src={`${base}images/research/${r.image}`}
            alt=""
            class="w-full aspect-[4/3] object-cover bg-primary-50"
            loading="lazy"
          />
        )}
        <div class="p-7">
          <p class="text-[11px] font-medium text-accent-600 tracking-wide mb-2">{r.field}</p>
          <h2 class="text-lg font-bold text-primary-900 mb-3 leading-snug">{r.title}</h2>
          <p class="text-sm text-primary-700 leading-[1.9]">{r.description}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-14 rounded-2xl border border-primary-100 p-7 bg-white">
    <h2 class="text-lg font-bold text-primary-900 mb-3">主な発表先の学会</h2>
    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm text-primary-700">
      <li>日本臨床検査医学会</li>
      <li>日本医学検査学会</li>
      <li>日本検査血液学会</li>
      <li>日本臨床化学会</li>
      <li>日本腎臓学会</li>
      <li>北陸臨床病理集談会</li>
      <li>日本臨床微生物学会</li>
      <li>日本環境感染学会</li>
    </ul>
  </div>
</PageLayout>
