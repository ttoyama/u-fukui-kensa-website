---
import PageLayout from '../layouts/PageLayout.astro';
import staff from '../data/staff.json';

const base = import.meta.env.BASE_URL;

// 資格表記「認定元 資格名」を分割して認定元を薄く表示する（医師・技師共通）
function splitQual(q: string): { body: string; qual: string } {
  const sp = q.indexOf(' ');
  return sp > 0 ? { body: q.slice(0, sp), qual: q.slice(sp + 1) } : { body: q, qual: '' };
}
---

<PageLayout title="スタッフ紹介" breadcrumb={[{ label: 'スタッフ紹介' }]}>
  <p class="text-[15px] text-primary-600 leading-[1.9] mb-12">
    臨床検査専門医・医師と、臨床検査技師がチームで検査を担っています。
  </p>

  <!-- 医師 -->
  <section class="mb-16">
    <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">医師</h2>
    <div class="divide-y divide-gray-100">
      {staff.physicians.map((m) => (
        <div class="flex items-start gap-5 py-5">
          <div class="w-20 shrink-0">
            {m.photo && (
              <img
                src={`${base}images/staff/${m.photo}`}
                alt={m.name}
                class="w-20 h-20 rounded-lg object-cover object-top border border-primary-100"
                loading="lazy"
              />
            )}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[11px] text-primary-400 mb-0.5">{m.ruby}</p>
            <div class="flex items-baseline gap-3 flex-wrap">
              <h3 class="font-bold text-primary-900 text-base">{m.name}</h3>
              <p class="text-xs text-primary-500">{m.title}</p>
            </div>
            {m.note && <p class="text-xs text-primary-400 mt-1">{m.note}</p>}
            {m.certifications && (
              <ul class="text-xs leading-relaxed mt-2 space-y-0.5">
                {m.certifications.map((c) => {
                  const { body, qual } = splitQual(c);
                  return (
                    <li>
                      <span class="text-primary-400">{body}</span>
                      {qual && <span class="text-primary-800 font-medium ml-1.5">{qual}</span>}
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- スタッフ -->
  <section class="mb-16">
    <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">スタッフ</h2>
    <div class="divide-y divide-gray-100">
      {staff.technologists.map((m) => (
        <div class="py-4">
          <p class="text-[11px] text-primary-400 mb-0.5">{m.ruby}</p>
          <div class="flex items-baseline gap-3 flex-wrap">
            <h3 class="font-bold text-primary-900 text-base">{m.name}</h3>
            <p class="text-xs text-primary-500">{m.title}</p>
          </div>
          {m.quals && (
            <ul class="text-xs leading-relaxed mt-1.5 space-y-0.5">
              {m.quals.map((q) => {
                const { body, qual } = splitQual(q);
                return (
                  <li>
                    <span class="text-primary-400">{body}</span>
                    {qual && <span class="text-primary-800 font-medium ml-1.5">{qual}</span>}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      ))}
    </div>
    <p class="text-sm text-primary-700 leading-[1.9] mt-6">
      常勤技師数 31名、非常勤技師数 4名
    </p>
  </section>

  <!-- 研究員 -->
  {staff.researchAffiliates && staff.researchAffiliates.length > 0 && (
    <section class="mb-16">
      <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">研究員</h2>
      <div class="divide-y divide-gray-100">
        {staff.researchAffiliates.map((m) => (
          <div class="py-4">
            <p class="text-[11px] text-primary-400 mb-0.5">{m.ruby}</p>
            <div class="flex items-baseline gap-3 flex-wrap">
              <h3 class="font-bold text-primary-900 text-base">{m.name}</h3>
            </div>
            {m.quals && (
              <ul class="text-xs leading-relaxed mt-1.5 space-y-0.5">
                {m.quals.map((q) => {
                  const { body, qual } = splitQual(q);
                  return (
                    <li>
                      <span class="text-primary-400">{body}</span>
                      {qual && <span class="text-primary-800 font-medium ml-1.5">{qual}</span>}
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 施設認定 -->
  <section>
    <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">施設認定</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <tbody>
          {staff.certifications.map((c) => (
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-6 text-primary-600 whitespace-nowrap">{c.org}</td>
              <td class="py-3 font-medium text-primary-900">{c.item}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</PageLayout>
