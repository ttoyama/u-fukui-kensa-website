---
import PageLayout from '../layouts/PageLayout.astro';
import staff from '../data/staff.json';

const base = import.meta.env.BASE_URL;
---

<PageLayout title="スタッフ紹介" breadcrumb={[{ label: 'スタッフ紹介' }]}>
  <p class="text-[15px] text-primary-600 leading-[1.9] mb-12">
    臨床検査専門医・医師と、臨床検査技師がチームで検査を担っています。
  </p>

  <!-- 医師・大学院生 -->
  <section class="mb-16">
    <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">医師</h2>
    <div class="divide-y divide-gray-100">
      {staff.physicians.map((m) => (
        <div class="flex items-start gap-5 py-5">
          <div class="w-20 shrink-0">
            {m.photo && (
              <img
                src={`${base}images/staff/${m.photo}`}
                alt={m.name}
                class="w-20 h-20 rounded-lg object-cover object-top border border-primary-100"
                loading="lazy"
              />
            )}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[11px] text-primary-400 mb-0.5">{m.ruby}</p>
            <div class="flex items-baseline gap-3 flex-wrap">
              <h3 class="font-bold text-primary-900 text-base">{m.name}</h3>
              <p class="text-xs text-primary-500">{m.title}</p>
            </div>
            {m.note && <p class="text-xs text-primary-400 mt-1">{m.note}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 臨床検査技師 -->
  <section class="mb-16">
    <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">スタッフ</h2>
    <div class="space-y-8">
      {staff.technologistGroups.map((g) => (
        <div>
          <p class="text-xs font-bold text-primary-600 mb-3">{g.title}</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3">
            {g.members.map((m) => (
              <div class="rounded-lg border border-primary-100 bg-primary-50 px-3.5 py-2.5">
                <p class="text-[10px] text-primary-400 leading-none mb-1">{m.ruby}</p>
                <p class="text-sm font-medium text-primary-900">{m.name}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 検査部で研究に取り組むメンバー -->
  {staff.researchAffiliates && staff.researchAffiliates.length > 0 && (
    <section class="mb-16">
      <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-3 section-line">検査部とともに研究する方</h2>
      <p class="text-sm text-primary-500 leading-[1.9] mb-6 max-w-2xl">
        現在は関連施設で診療にあたりながら、検査医学講座で研究を継続。
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3">
        {staff.researchAffiliates.map((m) => (
          <div class="rounded-lg border border-primary-100 bg-white px-3.5 py-2.5">
            <p class="text-[10px] text-primary-400 leading-none mb-1">{m.ruby}</p>
            <p class="text-sm font-medium text-primary-900">{m.name}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 施設認定 -->
  <section>
    <h2 class="text-xl md:text-2xl font-bold text-primary-900 mb-6 section-line">施設認定</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <tbody>
          {staff.certifications.map((c) => (
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-6 text-primary-600 whitespace-nowrap">{c.org}</td>
              <td class="py-3 font-medium text-primary-900">{c.item}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</PageLayout>
