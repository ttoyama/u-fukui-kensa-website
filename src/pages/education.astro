---
import PageLayout from '../layouts/PageLayout.astro';

const base = import.meta.env.BASE_URL;

const jobs = [
  { title: '検体検査', text: '血液や尿を分析装置や顕微鏡で調べます。貧血、感染症、がん、腎臓病など、多くの病気の手がかりが検査データから見つかります。' },
  { title: '生理検査', text: '心電図や脳波、肺活量など、患者さんの体から直接情報を記録します。患者さんと接する機会の多い検査です。' },
  { title: '超音波検査', text: '超音波（エコー）で心臓や腹部の臓器をリアルタイムに観察します。技師の腕が結果を左右する、専門性の高い分野です。' },
  { title: '緊急検査', text: '救急外来や手術室からの検査依頼に24時間対応します。一刻を争う場面で、検査データが治療方針を決めます。' },
];

const steps = [
  { step: '高校', text: '理科（特に生物・化学）が好きなら向いています。文系科目も大切です。' },
  { step: '大学・専門学校（3〜4年）', text: '臨床検査技師の養成課程で学びます。福井県内では福井医療大学などに養成課程があります。' },
  { step: '国家試験', text: '臨床検査技師国家試験に合格すると国家資格が得られます。' },
  { step: '就職', text: '病院の検査部、検査センター、健診機関、企業（試薬・医療機器メーカー）など、進路は多彩です。' },
];
---

<PageLayout title="教育・実習" breadcrumb={[{ label: '教育・実習' }]} wide>
  <p class="text-[15px] text-primary-600 leading-[1.9] mb-12 max-w-2xl">
    検査部では、臨床検査技師を目指す学生さんの臨地実習と、
    進路を考えている高校生・大学生の見学を受け入れています。
  </p>

  <!-- 臨床検査技師とは -->
  <section class="mb-16">
    <h2 class="text-xl font-bold text-primary-900 section-line mb-4">臨床検査技師という仕事</h2>
    <p class="text-[15px] text-primary-700 leading-[1.9] mb-8 max-w-2xl">
      臨床検査技師は、病気の診断や治療に欠かせない検査データをつくる国家資格の専門職です。
      医師が診断を下し、治療の効果を確かめる——その根拠の多くは、検査室から生まれています。
    </p>
    <div class="grid sm:grid-cols-2 gap-4">
      {jobs.map((j) => (
        <div class="rounded-2xl border border-primary-100 p-6 bg-primary-50">
          <h3 class="text-base font-bold text-primary-900 mb-2">{j.title}</h3>
          <p class="text-sm text-primary-700 leading-[1.8]">{j.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 臨床検査技師になるには -->
  <section class="mb-16">
    <h2 class="text-xl font-bold text-primary-900 section-line mb-8">臨床検査技師になるには</h2>
    <ol class="space-y-4">
      {steps.map((s, i) => (
        <li class="flex gap-4 items-start">
          <span class="shrink-0 w-8 h-8 rounded-full bg-accent-500 text-white text-sm font-bold flex items-center justify-center">{i + 1}</span>
          <div>
            <p class="text-sm font-bold text-primary-900">{s.step}</p>
            <p class="text-sm text-primary-600 leading-relaxed mt-0.5">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 臨地実習 -->
  <section class="mb-16">
    <h2 class="text-xl font-bold text-primary-900 section-line mb-4">臨地実習</h2>
    <p class="text-[15px] text-primary-700 leading-[1.9] max-w-2xl">
      臨床検査技師養成校の学生さんを対象に、臨地実習を受け入れています。
      検体検査から生理検査・超音波検査まで、大学病院ならではの多様な症例を経験できます。
      実習の受け入れについては、養成校を通じてお問い合わせください。
    </p>
  </section>

  <!-- 見学案内 -->
  <section>
    <div class="rounded-2xl border border-primary-200 p-8" style="background: linear-gradient(120deg, #eff6ff 0%, #fff7ed 100%);">
      <h2 class="text-xl font-bold text-primary-900 mb-3">見学はいつでも歓迎です</h2>
      <p class="text-[15px] text-primary-700 leading-[1.9] mb-6 max-w-2xl">
        進路を考えている高校生・大学生のみなさん、他大学・他施設の臨床検査技師のみなさんの見学を受け入れています。
        「検査室ってどんなところ？」という素朴な興味だけでも大丈夫です。お気軽にご連絡ください。
      </p>
      <a href={base + 'recruit/'} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-500 text-white text-sm font-bold hover:bg-primary-600 transition-colors">
        採用・見学案内を見る →
      </a>
    </div>
  </section>
</PageLayout>
